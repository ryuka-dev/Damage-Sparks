{
  "entries": [
    {
      "key": "plugin.name",
      "value": "SULFUR ダメージ数字"
    },
    {
      "key": "plugin.description",
      "value": "プレイヤーがダメージを与えた時、敵の上に浮かぶダメージ数字を表示します。"
    },
    {
      "key": "section.General",
      "value": "一般"
    },
    {
      "key": "section.Visual",
      "value": "表示"
    },
    {
      "key": "section.Filter",
      "value": "フィルター"
    },
    {
      "key": "section.Performance",
      "value": "パフォーマンス"
    },
    {
      "key": "section.Debug",
      "value": "デバッグ"
    },
    {
      "key": "entry.General.Enabled.name",
      "value": "有効"
    },
    {
      "key": "entry.General.Enabled.description",
      "value": "ダメージ数字の表示を有効にします。"
    },
    {
      "key": "entry.General.DamageDisplayMode.name",
      "value": "ダメージ表示モード"
    },
    {
      "key": "entry.General.DamageDisplayMode.description",
      "value": "PerTargetTotal は同じフレームで同じ対象に入った同じ種類のダメージを 1 つの数字に合算します。同じヒットに含まれる 2 種類目のダメージは 1 行上に表示します。PerHit は実際の各ダメージイベントを個別に表示します。"
    },
    {
      "key": "entry.Visual.Renderer.name",
      "value": "レンダラー"
    },
    {
      "key": "entry.Visual.Renderer.description",
      "value": "ScreenSpace を推奨します。WorldTextMeshPro は 3D テキストを使います。Both はデバッグ用に両方を有効にします。Vanilla はゲーム本体のダメージ表示（訓練用ダミーと同じもの）を使います。"
    },
    {
      "key": "entry.Visual.VanillaUseDamageTypeColors.name",
      "value": "バニラのダメージ属性色"
    },
    {
      "key": "entry.Visual.VanillaUseDamageTypeColors.description",
      "value": "Vanilla レンダラー専用。オンにするとゲーム本体のダメージ属性色（訓練用ダミーと同じ）を使います。オフにするとバニラの演出のままこの MOD の弱点色を使います。"
    },
    {
      "key": "entry.Visual.VanillaScale.name",
      "value": "バニラ文字サイズ"
    },
    {
      "key": "entry.Visual.VanillaScale.description",
      "value": "Vanilla レンダラー専用。ゲーム本体のダメージ表示の大きさ。1.0 は訓練用ダミーと同じ大きさです。"
    },
    {
      "key": "entry.Visual.UseWeakspotColors.name",
      "value": "弱点カラーを使用"
    },
    {
      "key": "entry.Visual.UseWeakspotColors.description",
      "value": "命中した部位に応じてダメージ数字に色を付けます。目は赤、頭は橙、胸部は黄、胴体と手足は白です。状態異常や爆発など部位のないダメージは白です。"
    },
    {
      "key": "entry.Visual.TreatOneMultiplierAsNormal.name",
      "value": "1.0x を通常扱い"
    },
    {
      "key": "entry.Visual.TreatOneMultiplierAsNormal.description",
      "value": "倍率 1.0 を橙ではなく白で表示します。頭への命中は 1.0 なので、有効にすると胴体への命中と同じく白になります。"
    },
    {
      "key": "entry.Visual.AggregateColorMode.name",
      "value": "合算ダメージの色"
    },
    {
      "key": "entry.Visual.AggregateColorMode.description",
      "value": "PerTargetTotal で複数ヒットを 1 つに合算する時の色ルールです。"
    },
    {
      "key": "entry.Filter.RequireNpcTarget.name",
      "value": "NPC 対象のみ"
    },
    {
      "key": "entry.Filter.RequireNpcTarget.description",
      "value": "NPC 対象にのみ表示します。樽などのオブジェクトを避けるため通常は有効のままにします。"
    },
    {
      "key": "entry.Filter.RequireSourceUnitPlayer.name",
      "value": "プレイヤーの発生元を要求"
    },
    {
      "key": "entry.Filter.RequireSourceUnitPlayer.description",
      "value": "sourceData.sourceUnit が存在し、プレイヤーであることを要求します。投射物や爆発に対応するため既定では無効です。"
    },
    {
      "key": "entry.Filter.ShowPlayerOwnedSecondaryEffects.name",
      "value": "プレイヤー所有の二次ダメージを表示"
    },
    {
      "key": "entry.Filter.ShowPlayerOwnedSecondaryEffects.description",
      "value": "プレイヤー由来の爆発など、武器や近接攻撃が発生源ではない二次ダメージを表示します。状態異常による継続ダメージは「状態異常ダメージを表示」で切り替えます。"
    },
    {
      "key": "entry.Filter.ShowStatusEffectDamage.name",
      "value": "状態異常ダメージを表示"
    },
    {
      "key": "entry.Filter.ShowStatusEffectDamage.description",
      "value": "プレイヤーが付与した燃焼・毒・感電などの継続ダメージを表示します。訓練用ダミーで見える色付きの数値はこれです。"
    },
    {
      "key": "entry.Filter.MinDamageToShow.name",
      "value": "表示する最小ダメージ"
    },
    {
      "key": "entry.Filter.MinDamageToShow.description",
      "value": "この値未満の最終ダメージは表示しません。"
    },
    {
      "key": "entry.Visual.ShowDecimals.name",
      "value": "小数を表示"
    },
    {
      "key": "entry.Visual.ShowDecimals.description",
      "value": "整数でないダメージは小数 1 桁を表示します。5.0 のような整数は 5 と表示します。Vanilla レンダラーは常に整数で表示します。"
    },
    {
      "key": "entry.Visual.Lifetime.name",
      "value": "表示時間"
    },
    {
      "key": "entry.Visual.Lifetime.description",
      "value": "各ダメージ数字が表示される秒数です。Vanilla レンダラーでは代わりにゲーム本体の演出に従います。"
    },
    {
      "key": "entry.Visual.FloatSpeed.name",
      "value": "ワールド上昇速度"
    },
    {
      "key": "entry.Visual.FloatSpeed.description",
      "value": "WorldTextMeshPro レンダラー専用。ワールド空間のダメージ数字が上に移動する速度です。"
    },
    {
      "key": "entry.Visual.WorldScale.name",
      "value": "ワールドスケール"
    },
    {
      "key": "entry.Visual.WorldScale.description",
      "value": "WorldTextMeshPro レンダラー専用。3D ダメージ数字のスケールです。"
    },
    {
      "key": "entry.Visual.RandomJitter.name",
      "value": "ランダムずれ"
    },
    {
      "key": "entry.Visual.RandomJitter.description",
      "value": "PerHit モード専用。数字ごとにワールド空間でランダムな横ずれを加えます。ショットガンの散弾に有効です。ScreenSpace レンダラーでは使われません。"
    },
    {
      "key": "entry.Visual.FontSize.name",
      "value": "ワールドフォントサイズ"
    },
    {
      "key": "entry.Visual.FontSize.description",
      "value": "WorldTextMeshPro レンダラー専用。3D ダメージ数字の TextMeshPro フォントサイズです。"
    },
    {
      "key": "entry.Visual.ScreenFontSize.name",
      "value": "画面フォントサイズ"
    },
    {
      "key": "entry.Visual.ScreenFontSize.description",
      "value": "ScreenSpace レンダラー専用。画面空間のダメージ数字のフォントサイズです。"
    },
    {
      "key": "entry.Visual.ScreenFloatSpeed.name",
      "value": "画面上昇速度"
    },
    {
      "key": "entry.Visual.ScreenFloatSpeed.description",
      "value": "ScreenSpace レンダラー専用。追加の上昇速度で、単位はピクセル/秒です。数字は対象の上にある基準点と一緒にゆっくり上がるため、0 にしても完全には止まりません。"
    },
    {
      "key": "entry.Visual.ScreenJitter.name",
      "value": "画面ランダムずれ"
    },
    {
      "key": "entry.Visual.ScreenJitter.description",
      "value": "PerHit モードかつ ScreenSpace レンダラー専用。数字ごとに画面空間でランダムなずれ（ピクセル単位）を加えます。ショットガンの散弾に有効です。"
    },
    {
      "key": "entry.Visual.PerHitStackScreenSpread.name",
      "value": "PerHit 画面拡散"
    },
    {
      "key": "entry.Visual.PerHitStackScreenSpread.description",
      "value": "ScreenSpace レンダラー専用。同じフレームで同じ対象に複数の PerHit 数字が出る時、決定的な画面拡散を追加します。ずれは最大 42 ピクセルです。"
    },
    {
      "key": "entry.Visual.PerHitStackWorldSpread.name",
      "value": "PerHit ワールド拡散"
    },
    {
      "key": "entry.Visual.PerHitStackWorldSpread.description",
      "value": "同じフレームで同じ対象に複数の PerHit 数字が出る時、決定的なワールド拡散を追加します。ScreenSpace レンダラーでは使われません。ずれは最大 0.36 です。"
    },
    {
      "key": "entry.Performance.MaxActiveNumbers.name",
      "value": "最大表示数"
    },
    {
      "key": "entry.Performance.MaxActiveNumbers.description",
      "value": "有効な各レンダラーごとのアクティブなダメージ数字の最大数です。1～256（Vanilla レンダラーは 1～64）に制限され、上限に達すると最も古い数字を再利用します。"
    },
    {
      "key": "entry.Performance.MaxNumbersPerFrame.name",
      "value": "1フレームの最大数字数"
    },
    {
      "key": "entry.Performance.MaxNumbersPerFrame.description",
      "value": "1フレームで新しく生成するダメージ数字の最大数です。1～256 に制限されます。超過したイベントは破棄され、ヒットの過剰表示を防ぎます。"
    },
    {
      "key": "entry.Performance.EnableCrowdingProtection.name",
      "value": "密集保護"
    },
    {
      "key": "entry.Performance.EnableCrowdingProtection.description",
      "value": "同じ狭い画面領域にすでに多くの数字がある場合、新しい数字をスキップします。視覚的な制限のみで、ダメージの統合や集計の変更は行いません。"
    },
    {
      "key": "entry.Performance.CrowdingRadius.name",
      "value": "密集半径"
    },
    {
      "key": "entry.Performance.CrowdingRadius.description",
      "value": "密集保護が使用する画面空間の半径（ピクセル）です。8～120 に制限されます。"
    },
    {
      "key": "entry.Performance.MaxNearbyNumbers.name",
      "value": "近接数字の最大数"
    },
    {
      "key": "entry.Performance.MaxNearbyNumbers.description",
      "value": "新しい数字をスキップするまでに密集半径内に存在できる数字の数です。1～32 に制限されます。"
    },
    {
      "key": "entry.Debug.DebugLog.name",
      "value": "デバッグログ"
    },
    {
      "key": "entry.Debug.DebugLog.description",
      "value": "受理/拒否されたダメージイベントを LogOutput.log に出力します。"
    },
    {
      "key": "entry.Debug.DebugSpawnTestOnF8.name",
      "value": "F8 テスト数字"
    },
    {
      "key": "entry.Debug.DebugSpawnTestOnF8.description",
      "value": "ゲーム内で F8 を押すと画面中央にテスト数字を表示します。テスト数字は常に ScreenSpace のスタイルで表示されます。"
    },
    {
      "key": "value.General.DamageDisplayMode.PerTargetTotal",
      "value": "対象別合計"
    },
    {
      "key": "value.General.DamageDisplayMode.PerHit",
      "value": "命中ごと"
    },
    {
      "key": "value.Visual.Renderer.ScreenSpace",
      "value": "画面空間"
    },
    {
      "key": "value.Visual.Renderer.WorldTextMeshPro",
      "value": "ワールド TextMeshPro"
    },
    {
      "key": "value.Visual.Renderer.Both",
      "value": "両方"
    },
    {
      "key": "value.Visual.Renderer.Vanilla",
      "value": "バニラ"
    },
    {
      "key": "value.Visual.AggregateColorMode.HighestMultiplier",
      "value": "最高倍率"
    },
    {
      "key": "value.Visual.AggregateColorMode.DamageWeightedAverage",
      "value": "ダメージ加重平均"
    },
    {
      "key": "value.Visual.AggregateColorMode.LastHit",
      "value": "最後の命中"
    }
  ]
}
