      "key": "plugin.name",
      "value": "Numeri danno SULFUR"
    },
    {
      "key": "plugin.description",
      "value": "Mostra numeri di danno fluttuanti sopra i nemici quando il giocatore infligge danno."
    },
    {
      "key": "section.General",
      "value": "Generale"
    },
    {
