    {
      "key": "entry.General.Enabled.name",
      "value": "Abilitato"
    },
    {
      "key": "entry.General.Enabled.description",
      "value": "Abilita la visualizzazione dei numeri di danno."
    },
    {
      "key": "entry.General.DamageDisplayMode.name",
      "value": "Modalità numeri danno"
    },
    {
      "key": "entry.General.DamageDisplayMode.description",
      "value": "PerTargetTotal unisce il danno nello stesso frame sullo stesso bersaglio. PerHit mostra ogni evento reale di danno separatamente."
    },
    {
      "key": "entry.Visual.Renderer.name",
      "value": "Renderer"
    },
    {
      "key": "entry.Visual.Renderer.description",
      "value": "ScreenSpace è consigliato. WorldTextMeshPro usa testo 3D. Both abilita entrambi i renderer per debug."
    },
    {
      "key": "entry.Visual.UseWeakspotColors.name",
      "value": "Usa colori punto debole"
    },
    {
      "key": "entry.Visual.UseWeakspotColors.description",
      "value": "Colora i numeri in base al moltiplicatore del colpo. I punti deboli sono giallo/arancione/rosso; senza moltiplicatore il danno è bianco."
    },
    {
      "key": "entry.Visual.TreatOneMultiplierAsNormal.name",
      "value": "Tratta 1.0x come normale"
    },
    {
      "key": "entry.Visual.TreatOneMultiplierAsNormal.description",
      "value": "Mostra il moltiplicatore 1.0 in bianco invece che arancione. Attivalo se i normali colpi al corpo sono segnalati come 1.0x."
    },
    {
      "key": "entry.Visual.AggregateColorMode.name",
      "value": "Colore danno unito"
    },
    {
      "key": "entry.Visual.AggregateColorMode.description",
      "value": "Regola colore usata quando PerTargetTotal unisce più colpi in un solo numero."
    },
    {
      "key": "entry.Filter.RequireNpcTarget.name",
      "value": "Richiedi bersaglio NPC"
    },
    {
      "key": "entry.Filter.RequireNpcTarget.description",
      "value": "Mostra i numeri solo sui bersagli NPC. Tienilo attivo per evitare oggetti come barili."
    },
    {
      "key": "entry.Filter.RequireSourceUnitPlayer.name",
      "value": "Richiedi origine giocatore"
    },
    {
      "key": "entry.Filter.RequireSourceUnitPlayer.description",
      "value": "Richiede che sourceData.sourceUnit esista e sia il giocatore. Disattivato di default per proiettili ed esplosioni."
    },
    {
      "key": "entry.Filter.ShowPlayerOwnedSecondaryEffects.name",
      "value": "Mostra danno secondario del giocatore"
    },
    {
      "key": "entry.Filter.ShowPlayerOwnedSecondaryEffects.description",
      "value": "Mostra esplosioni e danni secondari del giocatore. Disattiva se fuoco, veleno o DoT diventano troppo rumorosi."
    },
    {
      "key": "entry.Filter.MinDamageToShow.name",
      "value": "Danno minimo da mostrare"
    },
    {
      "key": "entry.Filter.MinDamageToShow.description",
      "value": "Il danno finale sotto questo valore non viene mostrato."
    },
    {
      "key": "entry.Visual.ShowDecimals.name",
      "value": "Mostra decimali"
    },
    {
      "key": "entry.Visual.ShowDecimals.description",
      "value": "Mostra una cifra decimale per danni non interi. Valori interi come 5.0 vengono ancora mostrati come 5."
    },
    {
      "key": "entry.Visual.Lifetime.name",
      "value": "Durata"
    },
    {
      "key": "entry.Visual.Lifetime.description",
      "value": "Tempo in cui ogni numero di danno resta visibile, in secondi."
    },
    {
      "key": "entry.Visual.FloatSpeed.name",
      "value": "Velocità salita mondo"
    },
    {
      "key": "entry.Visual.FloatSpeed.description",
