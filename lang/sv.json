    },
    {
      "key": "entry.General.DamageDisplayMode.name",
      "value": "Skadevisningsläge"
    },
    {
      "key": "entry.General.DamageDisplayMode.description",
      "value": "PerTargetTotal slår ihop skada i samma bildruta på samma mål. PerHit visar varje verklig skadehändelse separat."
    },
    {
      "key": "entry.Visual.Renderer.name",
      "value": "Rendererare"
    },
    {
      "key": "entry.Visual.Renderer.description",
      "value": "ScreenSpace rekommenderas. WorldTextMeshPro använder 3D-text. Both aktiverar båda för debug."
    },
    {
      "key": "entry.Visual.UseWeakspotColors.name",
      "value": "Använd svagpunktsfärger"
    },
    {
      "key": "entry.Visual.UseWeakspotColors.description",
      "value": "Färgar siffrorna efter träffmultiplikator. Svagpunkter är gula/orange/röda; utan multiplikator är skadan vit."
    },
    {
      "key": "entry.Visual.TreatOneMultiplierAsNormal.name",
      "value": "Behandla 1.0x som normalt"
    },
    {
      "key": "entry.Visual.TreatOneMultiplierAsNormal.description",
      "value": "Visar multiplikator 1.0 som vit i stället för orange. Aktivera om vanliga kroppsträffar rapporteras som 1.0x."
    },
    {
