    },
    {
      "key": "value.Visual.Renderer.Both",
      "value": "Both"
    },
    {
      "key": "value.Visual.AggregateColorMode.HighestMultiplier",
      "value": "Highest Multiplier"
    },
    {
      "key": "value.Visual.AggregateColorMode.DamageWeightedAverage",
      "value": "Damage-Weighted Average"
    },
    {
      "key": "value.Visual.AggregateColorMode.LastHit",
      "value": "Last Hit"
    }
  ]
