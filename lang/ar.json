    },
    {
      "key": "entry.Visual.PerHitStackScreenSpread.name",
      "value": "انتشار PerHit على الشاشة"
    },
    {
      "key": "entry.Visual.PerHitStackScreenSpread.description",
      "value": "انتشار شاشة إضافي محدد لعدة أرقام PerHit على نفس الهدف في نفس الإطار."
    },
    {
      "key": "entry.Visual.PerHitStackWorldSpread.name",
      "value": "انتشار PerHit في العالم"
    },
    {
      "key": "entry.Visual.PerHitStackWorldSpread.description",
      "value": "انتشار عالم إضافي لعدة أرقام PerHit على نفس الهدف في نفس الإطار."
    },
    {
      "key": "entry.Performance.MaxActiveNumbers.name",
      "value": "أقصى عدد نشط"
    },
    {
      "key": "entry.Performance.MaxActiveNumbers.description",
      "value": "أقصى عدد من أرقام الضرر النشطة في كل مُصيّر مُفعّل. محدود بين 1 و256؛ وعند الامتلاء يُعاد استخدام أقدم رقم نشط."
    },
    {
      "key": "entry.Performance.MaxNumbersPerFrame.name",
      "value": "أقصى أرقام لكل إطار"
    },
    {
      "key": "entry.Performance.MaxNumbersPerFrame.description",
      "value": "أقصى عدد من أرقام الضرر الجديدة التي تُنشأ في إطار واحد. محدود بين 1 و256. تُهمل الأحداث الزائدة لمنع تكدّس الإصابات."
    },
    {
      "key": "entry.Performance.EnableCrowdingProtection.name",
      "value": "الحماية من الازدحام"
    },
    {
      "key": "entry.Performance.EnableCrowdingProtection.description",
      "value": "يتخطّى رقمًا جديدًا عندما يشغل عدد كبير من الأرقام النشطة المنطقة الصغيرة نفسها من الشاشة. هو حدّ بصري فقط؛ لا يدمج الضرر ولا يغيّر التجميع."
    },
    {
      "key": "entry.Performance.CrowdingRadius.name",
      "value": "نصف قطر الازدحام"
    },
    {
      "key": "entry.Performance.CrowdingRadius.description",
      "value": "نصف قطر الشاشة بالبكسل الذي تستخدمه الحماية من الازدحام. محدود بين 8 و120."
    },
    {
      "key": "entry.Performance.MaxNearbyNumbers.name",
      "value": "أقصى أرقام قريبة"
    },
    {
      "key": "entry.Performance.MaxNearbyNumbers.description",
      "value": "عدد الأرقام المسموح بوجودها داخل نصف قطر الازدحام قبل تخطّي رقم جديد محجوب. محدود بين 1 و32."
    },
