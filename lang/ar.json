    {
      "key": "entry.General.Enabled.name",
      "value": "مفعّل"
    },
    {
      "key": "entry.General.Enabled.description",
      "value": "يفعّل عرض أرقام الضرر."
    },
    {
      "key": "entry.General.DamageDisplayMode.name",
      "value": "وضع عرض الضرر"
    },
    {
      "key": "entry.General.DamageDisplayMode.description",
      "value": "PerTargetTotal يدمج ضرر نفس الإطار على نفس الهدف. PerHit يعرض كل حدث ضرر حقيقي بشكل منفصل."
    },
    {
      "key": "entry.Visual.Renderer.name",
      "value": "المصيّر"
    },
    {
      "key": "entry.Visual.Renderer.description",
      "value": "يُنصح باستخدام ScreenSpace. يستخدم WorldTextMeshPro نصًا ثلاثي الأبعاد. يُفعّل Both كلا المحركين لأغراض التصحيح. يستخدم Vanilla نص الضرر الخاص باللعبة نفسها، وهو النص الذي يظهر على دُمى التدريب."
    },
    {
      "key": "entry.Visual.VanillaUseDamageTypeColors.name",
      "value": "ألوان أنواع الضرر الأصلية"
    },
    {
      "key": "entry.Visual.VanillaUseDamageTypeColors.description",
      "value": "لمحرك Vanilla فقط. عند التفعيل تُستخدم ألوان أنواع الضرر الخاصة باللعبة كما في دُمى التدريب. عند الإيقاف تُستخدم ألوان نقاط الضعف الخاصة بهذا التعديل مع حركة اللعبة الأصلية."
    },
    {
      "key": "entry.Visual.VanillaScale.name",
      "value": "حجم نص Vanilla"
    },
    {
      "key": "entry.Visual.VanillaScale.description",
      "value": "لمحرك Vanilla فقط. حجم نص الضرر الخاص باللعبة. القيمة 1.0 هي الحجم المستخدم في دُمى التدريب."
    },
    {
      "key": "entry.Visual.UseWeakspotColors.name",
      "value": "استخدام ألوان نقاط الضعف"
    },
    {
      "key": "entry.Visual.UseWeakspotColors.description",
      "value": "يلوّن الأرقام حسب مضاعف الإصابة. نقاط الضعف صفراء/برتقالية/حمراء؛ وعند عدم وجود مضاعف يكون الضرر أبيض."
    },
    {
      "key": "entry.Visual.TreatOneMultiplierAsNormal.name",
      "value": "اعتبار 1.0x عاديًا"
    },
    {
      "key": "entry.Visual.TreatOneMultiplierAsNormal.description",
      "value": "يعرض مضاعف 1.0 باللون الأبيض بدل البرتقالي. فعّله إذا كانت ضربات الجسم العادية تُسجّل 1.0x."
    },
    {
      "key": "entry.Visual.AggregateColorMode.name",
      "value": "لون الضرر المدمج"
    },
    {
      "key": "entry.Visual.AggregateColorMode.description",
      "value": "قاعدة اللون عند دمج عدة إصابات في رقم واحد بواسطة PerTargetTotal."
    },
    {
      "key": "entry.Filter.RequireNpcTarget.name",
      "value": "اشتراط هدف NPC"
    },
    {
      "key": "entry.Filter.RequireNpcTarget.description",
      "value": "يعرض الأرقام على أهداف NPC فقط. أبقه مفعّلًا لتجنب الأجسام مثل البراميل."
    },
    {
      "key": "entry.Filter.RequireSourceUnitPlayer.name",
      "value": "اشتراط أن يكون المصدر اللاعب"
    },
    {
      "key": "entry.Filter.RequireSourceUnitPlayer.description",
      "value": "يتطلب وجود sourceData.sourceUnit وأن يكون اللاعب. معطّل افتراضيًا للمقذوفات والانفجارات."
    },
    {
      "key": "entry.Filter.ShowPlayerOwnedSecondaryEffects.name",
      "value": "إظهار الضرر الثانوي للّاعب"
    },
    {
      "key": "entry.Filter.ShowPlayerOwnedSecondaryEffects.description",
      "value": "يعرض الانفجارات والضرر الثانوي المملوك للّاعب. عطّله إذا أصبح الحريق أو السم أو DoT مزعجًا."
    },
    {
      "key": "entry.Filter.ShowStatusEffectDamage.name",
      "value": "إظهار ضرر تأثيرات الحالة"
    },
    {
      "key": "entry.Filter.ShowStatusEffectDamage.description",
      "value": "يظهر الضرر المستمر الناتج عن تأثيرات الحالة التي يطبقها اللاعب، مثل الحرق والسم والصعق الكهربائي. وهي الأرقام الملونة التي تظهر على دُمى التدريب."
    },
    {
      "key": "entry.Filter.MinDamageToShow.name",
      "value": "أقل ضرر للعرض"
    },
    {
      "key": "entry.Filter.MinDamageToShow.description",
      "value": "لن يظهر الضرر النهائي الأقل من هذه القيمة."
    },
    {
      "key": "entry.Visual.ShowDecimals.name",
      "value": "إظهار الكسور"
    },
    {
      "key": "entry.Visual.ShowDecimals.description",
      "value": "يعرض منزلة عشرية للضرر غير الصحيح. القيم الصحيحة مثل 5.0 تظهر كـ 5."
    },
    {
      "key": "entry.Visual.Lifetime.name",
      "value": "مدة الظهور"
    },
    {
      "key": "entry.Visual.Lifetime.description",
      "value": "مدة بقاء كل رقم ضرر ظاهرًا بالثواني."
    },
    {
      "key": "entry.Visual.FloatSpeed.name",
      "value": "سرعة الصعود في العالم"
    },
    {
      "key": "entry.Visual.FloatSpeed.description",
      "value": "سرعة صعود أرقام الضرر في فضاء العالم."
    },
    {
      "key": "entry.Visual.WorldScale.name",
      "value": "مقياس العالم"
    },
    {
      "key": "entry.Visual.WorldScale.description",
      "value": "مقياس أرقام TextMeshPro في فضاء العالم."
    },
    {
