<Project>
  <PropertyGroup>
    <SulfurGameDir Condition="'$(SulfurGameDir)' == ''">D:\SteamLibrary\steamapps\common\SULFUR</SulfurGameDir>
    <SulfurManagedDir Condition="'$(SulfurManagedDir)' == ''">$(SulfurGameDir)\Sulfur_Data\Managed</SulfurManagedDir>
    <SulfurGaleProfileDir Condition="'$(SulfurGaleProfileDir)' == ''">C:\Users\LingYun67\AppData\Roaming\com.kesomannen.gale\sulfur\profiles\其他mod开发</SulfurGaleProfileDir>
    <SulfurBepInExCoreDir Condition="'$(SulfurBepInExCoreDir)' == ''">$(SulfurGaleProfileDir)\BepInEx\core</SulfurBepInExCoreDir>
    <SulfurBepInExPluginsDir Condition="'$(SulfurBepInExPluginsDir)' == ''">$(SulfurGaleProfileDir)\BepInEx\plugins</SulfurBepInExPluginsDir>
    <ThunderstoreDir Condition="'$(ThunderstoreDir)' == ''">$(MSBuildThisFileDirectory)Thunderstore</ThunderstoreDir>

    <!-- The SULFUR Together repository. Its Release build is the compile-time home of the public API the
         optional co-op adapter uses; the installed SULFUR Together provides it at run time. -->
    <SulfurTogetherDir Condition="'$(SulfurTogetherDir)' == ''">C:\Users\LingYun67\source\SULFUR Together</SulfurTogetherDir>

    <!-- The Thunderstore package name. The build output keeps its own assembly name, so the
         deploy step renames the copy to match what the released package has always shipped. -->
    <ThunderstorePluginName Condition="'$(ThunderstorePluginName)' == ''">DamageSparks</ThunderstorePluginName>

    <!-- The plugin folder Gale already manages for this mod. Deploying anywhere else would put a
         second copy of the same BepInEx GUID in the profile. -->
    <SulfurPluginFolderName Condition="'$(SulfurPluginFolderName)' == ''">ryuka_labs-DamageSparks</SulfurPluginFolderName>
  </PropertyGroup>
</Project>
